PORT=3001

# Admin panel password hash (generate with: node hash-password.js YourPassword)
ADMIN_PASSWORD_HASH=

# Session secret - set to any random string
SESSION_SECRET=change-this-to-something-random

# Gmail (use an App Password, not your real password)
# Enable 2FA on your Google account, then generate an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The email where new booking alerts are sent (can be same as GMAIL_USER)
ADMIN_EMAIL=info@motowarehouse.com.cy

# Your site URL (used in email links)
SITE_URL=https://your-railway-app.up.railway.app

# Twilio SMS (optional - leave blank to skip SMS)
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890
