PORT=3001

# Admin panel password hash (generate with: node hash-password.js YourPassword)
ADMIN_PASSWORD_HASH=

# Session secret - set to any random string
SESSION_SECRET=change-this-to-something-random

# Brevo API key (used for both Email AND SMS)
# Sign up free at https://www.brevo.com
BREVO_API_KEY=your-brevo-api-key-here

# The email where new booking alerts are sent
ADMIN_EMAIL=info@motowarehouse.com.cy

# Your site URL (used in email links)
SITE_URL=https://your-railway-app.up.railway.app
